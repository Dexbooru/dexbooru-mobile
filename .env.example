# Machine-specific overrides go in .env.local (gitignored).
# Expo loads these automatically:
#   npm start            → .env.development
#   npm run start:build  → .env.production
#   npm run build        → .env.production
#
# Development
EXPO_PUBLIC_API_URL=http://localhost:5173
#
# Production / build mode
# EXPO_PUBLIC_API_URL=https://dexbooru.neetbyte.fun
